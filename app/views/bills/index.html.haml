.container.py-4
  %h1.text-center Bills
  %p.text-center Search congress.gov for bills by congress and bill type.

  = form_with url: bills_path, method: :get, local: true, class: 'row g-3 justify-content-center mb-4' do |f|
    .col-auto
      = f.label :congress, 'Congress', class: 'form-label'
      = f.number_field :congress, value: @congress, min: 1, placeholder: '119', class: 'form-control'
    .col-auto
      = f.label :bill_type, 'Bill type', class: 'form-label'
      = f.select :bill_type,
                 options_for_select(@bill_types.map { |t| [t.upcase, t] }, @bill_type),
                 { include_blank: 'All types' },
                 class: 'form-select'
    .col-auto.align-self-end
      = f.submit 'Search', name: nil, class: 'btn btn-primary'

  - if @error
    .alert.alert-danger{ role: 'alert' }= @error

  - if @bills.any?
    %p.text-center#bills-count
      Showing #{@bills.size} of #{number_with_delimiter(@total_count)} bills
    .table-responsive
      %table.table.table-striped.table-hover#bills-results
        %caption.visually-hidden Bills from congress.gov
        %thead
          %tr
            %th{ scope: 'col' } #
            %th{ scope: 'col' } Title
            %th{ scope: 'col' } Congress
            %th{ scope: 'col' } Type
            %th{ scope: 'col' } Chamber
            %th{ scope: 'col' } Last Action
            %th{ scope: 'col' }
              %span.visually-hidden Save
        %tbody
          - @bills.each do |bill|
            %tr
              %th{ scope: 'row' }= bill_number_label(bill)
              %td= bill['title']
              %td= bill['congress']
              %td= bill_type_name(bill)
              %td= bill['originChamber']
              %td= bill_last_action(bill)
              %td
                = button_to 'Save', bills_path, method: :post,
                  params: { congress: bill['congress'], bill_type: bill['type'].to_s.downcase, number: bill['number'] },
                  class: 'btn btn-sm btn-outline-primary'
